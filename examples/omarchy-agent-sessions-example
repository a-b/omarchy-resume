#!/usr/bin/env python3
"""Example session adapter for Recall.

Drop an executable named `omarchy-agent-sessions-<id>` on PATH, or as
`~/.config/omarchy/agents/sessions/<id>`, and Recall will discover it the
same way the agents panel discovers `omarchy-agent-usage-<id>` collectors.

Commands:
  list [--limit N]          JSON array or JSONL of sessions
  preview <session-id>      transcript text
  resume <session-id>       JSON { "command": [...], "cwd": "..." }
"""

from __future__ import annotations

import json
import sys
from pathlib import Path


def list_sessions() -> list[dict]:
    return [
        {
            "id": "demo-1",
            "title": "Example session from a third-party adapter",
            "cwd": str(Path.home()),
            "updatedAt": "2026-08-15T12:00:00+00:00",
            "model": "demo",
            "messageCount": 2,
            "snippet": "Ship a session adapter the same way you ship a usage collector.",
        }
    ]


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        print(__doc__)
        return 0
    command = argv[0]
    if command == "list":
        json.dump(list_sessions(), sys.stdout)
        sys.stdout.write("\n")
        return 0
    if command == "preview" and len(argv) >= 2:
        print("You\nShip a session adapter the same way you ship a usage collector.\n")
        print("Agent\nDone. Recall will pick it up on the next open.")
        return 0
    if command == "resume" and len(argv) >= 2:
        json.dump({"command": ["true"], "cwd": str(Path.home())}, sys.stdout)
        sys.stdout.write("\n")
        return 0
    print("usage: omarchy-agent-sessions-example list|preview|resume", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
